# RPC: required in production. Use archive endpoints, e.g.
# https://base-mainnet.g.alchemy.com/v2/<key> and https://base-sepolia.g.alchemy.com/v2/<key>
# (enable Base Mainnet and Base Sepolia in the Alchemy app first).
# The public fallbacks (mainnet.base.org, sepolia.base.org) are pruned and cannot backfill.
PONDER_RPC_URL_8453=
PONDER_RPC_URL_84532=

# Postgres for production. Without it, `npm run dev` uses PGlite in .ponder/.
# In docker-compose this is set automatically from POSTGRES_PASSWORD.
DATABASE_URL=

# docker-compose only
POSTGRES_PASSWORD=
# Bump this on every deploy that changes the schema or indexing logic (Ponder needs a fresh schema).
DEPLOYMENT_ID=v1

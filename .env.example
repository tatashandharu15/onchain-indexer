# RPC: required in production. Envio HyperRPC (archive, no eth_getLogs block-range cap):
# https://base.rpc.hypersync.xyz/<token> and https://base-sepolia.rpc.hypersync.xyz/<token>
# Token: https://envio.dev/app/hyperrpc-tokens (a HyperRPC token, not a HyperSync one).
# Alchemy's free plan caps eth_getLogs at 10 blocks and Base makes several blocks per second, so it cannot backfill.
# The public fallbacks (mainnet.base.org, sepolia.base.org) are pruned and cannot backfill either.
PONDER_RPC_URL_8453=
PONDER_RPC_URL_84532=

# Postgres for production. Without it, `npm run dev` uses PGlite in .ponder/.
# In docker-compose this is set automatically from POSTGRES_PASSWORD.
DATABASE_URL=

# docker-compose only
POSTGRES_PASSWORD=
# Bump this on every deploy that changes the schema or indexing logic (Ponder needs a fresh schema).
DEPLOYMENT_ID=v1

# Catch-up loop (seconds): each run indexes to the head, then pauses. Lag is at most about the pause plus startup.
INDEX_RUN_SECONDS=240
INDEX_PAUSE_SECONDS=60
